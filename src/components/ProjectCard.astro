---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	project: CollectionEntry<'projects'>;
	// "row" : image à gauche, texte à droite (page Projets).
	// "stacked" : image au-dessus du texte (page d'accueil).
	layout?: 'row' | 'stacked';
}

const { project, layout = 'stacked' } = Astro.props;
const { title, summary, tags, cover, coverAlt } = project.data;
---

<a href={`/projets/${project.id}`} class:list={['card', layout]}>
	<div class="media">
		{
			cover ? (
				<Image src={cover} alt={coverAlt ?? title} widths={[320, 640, 960]} sizes="(max-width: 640px) 100vw, 480px" />
			) : (
				<div class="placeholder" aria-hidden="true">
					{title.charAt(0)}
				</div>
			)
		}
	</div>
	<div class="body">
		<h3>{title}</h3>
		<p class="muted">{summary}</p>
		{tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
	</div>
</a>

<style>
	.card {
		display: flex;
		border: 1px solid var(--border);
		border-radius: 6px;
		overflow: hidden;
		text-decoration: none;
		color: var(--fg);
		background: var(--bg);
		transition:
			border-color 0.15s,
			box-shadow 0.15s;
	}

	.card:hover {
		border-color: var(--accent);
		box-shadow: 0 6px 20px var(--shadow);
	}

	.card:hover h3 {
		color: var(--accent);
	}

	.stacked {
		flex-direction: column;
	}

	.media {
		flex-shrink: 0;
		background: var(--bg-raised);
	}

	.stacked .media {
		aspect-ratio: 16 / 9;
	}

	.row .media {
		width: 16rem;
		aspect-ratio: 4 / 3;
	}

	.media img,
	.placeholder {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		display: grid;
		place-items: center;
		font-size: 2.5rem;
		font-weight: 600;
		color: var(--muted);
	}

	.body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 1rem 1.25rem;
	}

	h3 {
		margin: 0 0 0.4rem;
		font-size: 1.15rem;
		transition: color 0.15s;
	}

	.row h3 {
		font-size: 1.3rem;
	}

	p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.tags {
		margin-top: auto;
		padding-top: 0.75rem;
		font-family: var(--font-ui);
		font-size: 0.68rem;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.row {
			flex-direction: column;
		}

		.row .media {
			width: 100%;
			aspect-ratio: 16 / 9;
		}
	}
</style>
