---
import { profile } from '../data/profile';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';

const path = Astro.url.pathname;
const nav = [
	{ href: '/', label: 'Accueil' },
	{ href: '/projets', label: 'Projets' },
	{ href: '/articles', label: 'Articles' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
	<nav>
		<a href="/" class="name">{profile.name}</a>
		<ul>
			{
				nav.map((item) => (
					<li>
						<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="icons">
			<li>
				<a
					href={profile.links.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
					title="LinkedIn"
				>
					<LinkedinIcon width={16} height={16} />
				</a>
			</li>
			<li>
				<a
					href={profile.links.github}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
					title="GitHub"
				>
					<GithubIcon width={16} height={16} />
				</a>
			</li>
			<li>
				<button type="button" id="theme-toggle" aria-label="Changer de thème" title="Changer de thème">
					<svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
					</svg>
					<svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
					</svg>
				</button>
			</li>
		</ul>
	</nav>
</header>

<script>
	const button = document.getElementById('theme-toggle');
	const root = document.documentElement;
	const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

	const current = () => root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light');

	button?.addEventListener('click', () => {
		const next = current() === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	header {
		max-width: calc(var(--max-width) + 12rem);
		margin: 0 auto;
		padding: 0 1rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-ui);
		font-size: 0.78rem;
	}

	.name {
		margin-right: auto;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--fg);
		text-decoration: none;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	ul a,
	button {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}

	ul a:hover,
	ul a[aria-current='page'],
	button:hover {
		color: var(--fg);
	}

	ul a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.35em;
	}

	.icons {
		gap: 0.9rem;
	}

	.icons a,
	button {
		display: flex;
	}

	button {
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	/* Une seule icône visible : la lune en mode clair, le soleil en mode sombre. */
	.sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .sun {
		display: block;
	}

	:global(:root[data-theme='dark']) .moon {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: block;
		}

		:global(:root:not([data-theme='light'])) .moon {
			display: none;
		}
	}
</style>
