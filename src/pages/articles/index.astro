---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Articles">
	<h1>Articles</h1>
	<h2 class="label">Tous les articles</h2>
	{articles.length === 0 && <p class="muted">Aucun article pour le moment.</p>}
	<ul class="list">
		{
			articles.map((article) => (
				<li>
					<a href={`/articles/${article.id}`}>
						<h3>{article.data.title}</h3>
					</a>
					<p class="muted">{article.data.description}</p>
					<div class="meta">
						<FormattedDate date={article.data.date} />
						{article.data.tags.length > 0 && <> · {article.data.tags.join(' · ')}</>}
					</div>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	a {
		color: var(--fg);
		text-decoration: none;
	}

	a:hover h3 {
		color: var(--accent);
	}

	h3 {
		margin: 0;
		font-size: 1.2rem;
		transition: color 0.15s;
	}

	p {
		margin: 0.25rem 0 0.35rem;
		font-size: 0.95rem;
		line-height: 1.55;
	}
</style>
